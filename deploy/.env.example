# =============================================================================
# sing-box 企业级代理面板 —— 部署环境变量模板
#
# 用法：
#   1) 一键部署脚本会自动基于本模板生成 .env，并注入随机密钥：
#        curl -sSL https://raw.githubusercontent.com/sle58083/yc-box/main/deploy/install.sh | bash
#   2) 手动部署：cp .env.example .env，然后按需修改，再 docker compose up -d
#
# ⚠️ 备份提醒：.env 内含加密密钥，生成后请务必备份；密钥更换将导致库内加密字段无法解密。
# =============================================================================

# ---------- 对外端口 ----------
# 前端（nginx）对外 HTTP 端口
PUBLIC_PORT=80

# ---------- PostgreSQL ----------
DB_USER=singbox
# 数据库密码（install.sh 会自动生成强随机值）
DB_PASSWORD=
DB_NAME=singbox_panel

# ---------- 加密与签名密钥（install.sh 会自动生成，切勿修改/泄露）----------
# AES-256 密钥：32 字节 hex（64 字符）。生成命令：openssl rand -hex 32
# ⚠️ 生成后不可更换，否则库内已加密字段（私钥/UUID/令牌等）将无法解密
CRYPTO_KEY=
# JWT 签名密钥。生成命令：openssl rand -hex 32
JWT_SECRET=

# ---------- 初始管理员（仅首次启动、面板无用户时创建）----------
ADMIN_USERNAME=admin
# 初始管理员密码（install.sh 会自动生成强随机值，部署完成后请登录修改）
ADMIN_PASSWORD=

# ---------- 单机节点 Agent ----------
# Agent 连接控制面的令牌。install.sh 首次部署时会自动创建节点并回填；
# 也可手动在面板「节点管理」创建节点后，将其返回的 agent_token 填入此处。
AGENT_TOKEN=

# ---------- 单机节点入站端口范围 ----------
# sing-box 入站端口（TCP/UDP）会在宿主机映射该范围；
# 在面板配置入站协议时，端口必须落在此范围内。可按需改为 443:443 或更宽范围。
NODE_PORT_RANGE=10000-10100

# ---------- 日志 ----------
LOG_LEVEL=info
LOG_FORMAT=json

# ---------- 镜像仓库（可选覆盖）----------
# 默认镜像前缀定义在 docker-compose.yml（ghcr.io/sle58083）。
# 如需覆盖，取消注释并设置（须与 .github/workflows/release.yml 的 github.repository_owner 一致）：
# IMAGE_PREFIX=ghcr.io/myorg
# IMAGE_TAG=latest

# ---------- Compose 项目名（可选）----------
# COMPOSE_PROJECT_NAME=singbox-panel
