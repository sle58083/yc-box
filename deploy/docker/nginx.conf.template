# 前端容器内的 Nginx 配置模板（运行时由 entrypoint.sh 用 envsubst 生成）：
#   1) 托管 Vite 构建产物（SPA）
#   2) 面板路径随机化：${PANEL_PATH} 非空时，面板挂载到 /<PANEL_PATH>/，根路径 404 隐藏入口
#   3) 反代 /api/、/ws/ 到控制面；/healthz 保持根路径（不随面板路径隐藏）
#
# ${PANEL_PATH} 由 entrypoint.sh 注入：
#   - 非空：注入为 "/<随机hex>/"（如 /a1b2c3/）
#   - 空  ：注入为 "/"（根路径，兼容旧实例），并删除下方 location = / 404 规则
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 传输压缩
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 1024;

    # 面板入口隐藏：根路径返回 404（仅当 PANEL_PATH 非空时生效；
    # PANEL_PATH 为空时 entrypoint.sh 会删除本 location，改为根路径直接提供 SPA）
    location = / {
        return 404;
    }

    # 不带尾斜杠的面板路径：301 重定向到带尾斜杠（否则不匹配下方 location，会 404）
    # 例如 /a1b2c3 -> /a1b2c3/（${PANEL_PATH_BARE} 为不带尾斜杠的路径）
    location = ${PANEL_PATH_BARE} {
        return 301 ${PANEL_PATH};
    }

    # 面板 SPA：静态资源 + history 路由回退到 index.html
    # 使用 alias 将 /<PANEL_PATH>/ 映射到构建产物根目录，保证相对资源路径正确加载
    location ${PANEL_PATH} {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ ${PANEL_PATH}index.html;
    }

    # 带 hash 的静态资源可长期缓存
    location ${PANEL_PATH}assets/ {
        alias /usr/share/nginx/html/assets/;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # 控制面 REST API（/api/v1/*）
    location /api/ {
        proxy_pass http://control-plane:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # 控制面健康检查（透传 /healthz）
    location = /healthz {
        proxy_pass http://control-plane:8080;
        proxy_set_header Host $host;
    }

    # Agent WebSocket 长连接（/ws/agent）
    # 关键：必须带 Upgrade/Connection 头，否则无法建立长连接
    location /ws/ {
        proxy_pass http://control-plane:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket 长连接超时放宽 + 关闭缓冲，避免帧被延迟
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
